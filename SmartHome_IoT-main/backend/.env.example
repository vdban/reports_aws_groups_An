# ============ LOCAL DEV ============
USE_LOCAL_DB=true
PORT=5000
JWT_SECRET=smarthome-dev-secret
ALLOW_PUBLIC_REGISTER=true
SIMULATE_DOOR=true
ALLOW_DEV_SIMULATOR=true

# Cognito tắt khi dev local — dùng admin/admin123 trong DynamoDB
# COGNITO_ENABLED=false

# Virtual ESP32 (chạy: npm run simulator)
# SIMULATOR_MODE=http
# SIMULATOR_BACKEND_URL=http://localhost:5000

# ============ AWS PRODUCTION (EC2) ============
# USE_LOCAL_DB=false
# NODE_ENV=production
# AWS_REGION=ap-southeast-2
# DYNAMODB_TABLE=SmartHome

# Cognito (khuyến nghị production)
# COGNITO_ENABLED=true
# COGNITO_USER_POOL_ID=ap-southeast-2_XXXXXXX
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT fallback (chỉ khi COGNITO_ENABLED=false)
# JWT_SECRET=<random-32-chars>

# CORS — URL EC2 (frontend + API cùng nginx)
# CORS_ORIGIN=http://EC2_PUBLIC_IP

# CloudWatch
# CLOUDWATCH_ENABLED=true
# CLOUDWATCH_LOG_GROUP=/smarthome/audit
# CLOUDWATCH_APP_LOG_GROUP=/smarthome/app
# CLOUDWATCH_LOG_STREAM=backend-ec2

# AWS IoT Core MQTT
# MQTT_ENABLED=true
# IOT_ENDPOINT=xxxxx-ats.iot.ap-southeast-2.amazonaws.com
# IOT_CLIENT_ID=YoloHomeBackend

# Security
# ALLOW_PUBLIC_REGISTER=false
# SIMULATE_DOOR=false
